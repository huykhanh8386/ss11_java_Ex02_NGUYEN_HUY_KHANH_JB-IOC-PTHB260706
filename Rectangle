public class Rectangle implements Shape{
    private double width;
    private double height;

    public Rectangle(double height, double width) {
        this.height = height;
        this.width = width;
    }

    @Override
    public double Area() {
        return width * height;
    }

    @Override
    public double Primeter() {
        return (width + height) * 2;
    }
}
